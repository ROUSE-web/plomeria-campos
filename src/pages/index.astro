---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroSection from "@components/ui/sections/HeroSection.astro";
import Image from "@components/ui/images/Image.astro";

const posts: CollectionEntry<"posts">[] = (await getCollection("posts"))
    .sort(
        (a: CollectionEntry<"posts">, b: CollectionEntry<"posts">) =>
            b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    )
    .slice(0, 6);
---

<BaseLayout 
    title="Inicio" 
    description="Empresa l&iacute;der en ingeniería hidrosanitaria y plomer&iacute;a en Bolivia. Soluciones t&eacute;cnicas confiables para hogar e industria."
>
    <HeroSection
        title=`Plomería <span class="text-primary dark:text-secondary">Campos</span>`
        subTitle="Expertos en ingenier&iacute;a hidrosanitaria y plomer&iacute;a t&eacute;cnica. Soluciones integrales de agua, alcantarillado y sistemas contraincendios con cobertura en toda Bolivia."
        primaryBtn="Cotizar servicio"
        primaryBtnURL="https://wa.me/59178300509/?text=Hola%20Plomería%20Campos%2C%20me%20gustaría%20cotizar%20un%20servicio"
    />

    <!-- Pain Points Section -->
    <section class="py-20 bg-neutral-50 dark:bg-gradient-to-b dark:from-[#070f1e] dark:to-[#050a11] border-y border-neutral-200 dark:border-secondary/10">
        <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <h2 class="text-xs font-bold text-secondary uppercase tracking-[0.4em] mb-4">&iquest;Algo no va bien?</h2>
                <h3 class="text-3xl md:text-5xl font-bold text-primary dark:text-neutral-100 uppercase tracking-widest leading-tight mb-6">
                    Solucionamos los <span class="text-secondary">problemas</span> que le quitan el sue&ntilde;o
                </h3>
                <p class="text-lg text-neutral-600 dark:text-neutral-400">
                    &iquest;Se le rompi&oacute; una tuber&iacute;a? &iquest;Tiene una emergencia? No se preocupe, nosotros lo solucionamos r&aacute;pido y con garant&iacute;a.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
                {[
                    { t: "Fugas de Agua", d: "Detecci&oacute;n y reparaci&oacute;n inmediata de filtraciones.", i: "M12 21c-4.418 0-8-3.582-8-8 0-4.418 8-13 8-13s8 8.582 8 13c0 4.418-3.582 8-8 8z" },
                    { t: "Tuber&iacute;as Tapadas", d: "Desobstrucci&oacute;n profunda con equipo especializado.", i: "M5 4h4M7 4v11a5 5 0 0010 0v-7a4 4 0 014-4h2M23 2v4" },
                    { t: "Baja Presi&oacute;n", d: "Optimizaci&oacute;n de flujo y mantenimiento de bombas.", i: "M13 10V3L4 14h7v7l9-11h-7z" },
                    { t: "Instalaciones", d: "Correcci&oacute;n de trabajos defectuosos o antiguos.", i: "M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" },
                    { t: "Emergencias 24/7", d: "Atenci&oacute;n t&eacute;cnica urgente en cualquier momento.", i: "M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" }
                ].map((item) => (
                    <div class="group relative bg-white dark:bg-[#162947] border border-neutral-200 dark:border-secondary/20 p-8 rounded-3xl shadow-sm transition-all duration-500 hover:bg-neutral-50 dark:hover:bg-[#1e355b] hover:border-secondary/50 hover:shadow-[0_20px_50px_rgba(0,0,0,0.06)] dark:hover:shadow-[0_20px_50px_rgba(128,204,226,0.2)] hover:-translate-y-1.5 overflow-hidden">
                        <div class="relative z-10">
                            <div class="mb-5 flex size-12 items-center justify-center rounded-2xl shadow-sm bg-neutral-50 dark:bg-[#0f1d32] border border-neutral-200 dark:border-secondary/20 group-hover:bg-primary dark:group-hover:bg-[#0f1d32] group-hover:border-primary transition-all duration-500">
                                <svg class="size-6 text-secondary group-hover:text-white dark:group-hover:text-secondary transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d={item.i} />
                                </svg>
                            </div>
                            <h4 class="text-lg font-bold text-primary dark:text-white mb-3 leading-tight uppercase tracking-widest" set:html={item.t}></h4>
                            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed" set:html={item.d}></p>
                        </div>
                    </div>
                ))}
            </div>
            
            <div class="mt-12 text-center">
                <a href="https://wa.me/59178300509" class="inline-flex items-center gap-x-2 text-secondary font-bold uppercase tracking-widest text-xs hover:text-primary transition-colors">
                    <span>Atenci&oacute;n Inmediata por WhatsApp</span>
                    <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Nuestros Servicios Section -->
    <section class="mx-auto max-w-[85rem] px-4 py-24 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto text-center mb-16">
            <h2 class="text-xs font-bold text-secondary uppercase tracking-[0.4em] mb-4">Experiencia Garantizada</h2>
            <h3 class="text-4xl md:text-5xl font-bold text-primary dark:text-neutral-100 uppercase tracking-widest leading-none mb-6">Nuestros Servicios</h3>
            <p class="text-lg text-neutral-500 dark:text-neutral-400">Soluciones técnicas confiables y profesionales para su hogar o empresa.</p>
            <div class="mt-8 h-1 w-24 bg-secondary mx-auto rounded-full"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {
                posts.map((post, idx) => (
                    <a
                        href={`/services/${post.slug}/`}
                        class="group relative flex flex-col bg-white dark:bg-neutral-900/40 rounded-[2.5rem] border border-neutral-200 dark:border-neutral-800 overflow-hidden transition-all duration-500 hover:shadow-[0_30px_60px_rgba(0,0,0,0.1)] dark:hover:shadow-[0_30px_60px_rgba(0,0,0,0.5)] hover:-translate-y-2"
                    >
                        <!-- Image Container -->
                        <div class="relative h-64 w-full overflow-hidden">
                            <Image
                                src={post.data.banner}
                                alt={post.data.title}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 group-hover:brightness-75"
                                draggable="false"
                                format="avif"
                            />
                            <div class="absolute inset-0 bg-primary/40 backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transition-all duration-500 flex items-center justify-center p-8">
                                <span class="px-6 py-3 border-2 border-white text-white font-bold text-xs uppercase tracking-[0.3em] rounded-full transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                    Ver Detalles
                                </span>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="p-8 flex flex-col flex-grow relative overflow-hidden">
                            <!-- Background Number Watermark -->
                            <div class="absolute -right-4 -bottom-6 text-9xl font-black text-neutral-50 dark:text-neutral-800/20 group-hover:text-primary/5 transition-colors pointer-events-none select-none">
                                0{idx + 1}
                            </div>

                            <div class="relative z-10">
                                <h3 class="text-2xl font-bold text-primary dark:text-neutral-100 uppercase tracking-widest mb-4 leading-tight group-hover:text-secondary transition-colors">
                                    {post.data.title}
                                </h3>
                                <p class="text-neutral-500 dark:text-neutral-400 text-sm leading-relaxed line-clamp-3">
                                    {post.data.description}
                                </p>

                                <div class="mt-4 flex items-center gap-x-2 text-[10px] font-bold text-secondary uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                                    <span>Explorar Servicio</span>
                                    <svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>

        <div class="mt-20 text-center">
            <a
                href="/services"
                class="group inline-flex items-center gap-x-3 px-8 py-4 bg-white dark:bg-neutral-900 border-2 border-primary dark:border-secondary text-primary dark:text-secondary font-bold uppercase tracking-[0.2em] text-xs rounded-full transition-all duration-500 hover:bg-primary hover:text-white dark:hover:bg-secondary dark:hover:text-primary hover:shadow-2xl hover:shadow-primary/20 hover:-translate-y-1"
            >
                Ver todos los servicios
                <svg
                    class="size-4 transition-transform duration-500 group-hover:translate-x-2"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
            </a>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="py-24 bg-neutral-50 dark:bg-gradient-to-b dark:from-[#070f1e] dark:to-[#050a11] border-y border-neutral-200 dark:border-secondary/10">
        <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <h2 class="text-xs font-bold text-secondary uppercase tracking-[0.4em] mb-4">Confianza que Construye</h2>
                <h3 class="text-4xl md:text-5xl font-bold text-primary dark:text-neutral-100 uppercase tracking-widest leading-none mb-6">
                    Lo que dicen nuestros <span class="text-secondary">clientes</span>
                </h3>
                <p class="text-lg text-neutral-600 dark:text-neutral-400">
                    La satisfacci&oacute;n de quienes conf&iacute;an en nosotros es nuestro mejor respaldo y garant&iacute;a de calidad.
                </p>
            </div>
        </div>

        <!-- Carousel Container -->
        <div class="relative w-full" id="testimonial-carousel-wrapper">
            <!-- Gradient fade edges -->
            <div class="absolute left-0 top-0 bottom-0 w-24 md:w-40 z-10 pointer-events-none bg-gradient-to-r from-neutral-50 dark:from-[#070f1e] to-transparent"></div>
            <div class="absolute right-0 top-0 bottom-0 w-24 md:w-40 z-10 pointer-events-none bg-gradient-to-l from-neutral-50 dark:from-[#070f1e] to-transparent"></div>

            <div class="overflow-hidden py-12" id="testimonial-viewport">
                <div class="flex gap-6 transition-none" id="testimonial-track" style="will-change: transform;">
                    <!-- Cards injected by JS -->
                </div>
            </div>

            <!-- Dot indicators -->
            <div class="flex justify-center gap-2 mt-2" id="testimonial-dots"></div>
        </div>
    </section>

    <script is:inline>
    (function () {
        const testimonials = [
            { n: "Dra. Marcela Quiroz y Arq. Erik", r: "Constructora DRY LINE", t: "En Constructora DRY LINE confiamos plenamente en Plomería Campos para toda nuestra ingeniería hidrosanitaria. Su profesionalismo, cumplimiento de normas y calidad técnica son excepcionales.", s: 5 },
            { n: "Ing. Carlos Montan", r: "CONTMIN S.A.C.", t: "Excelente trabajo en la instalación de la red de agua y el sistema de supresión de incendios en el Túnel Incahuasi. Su solvencia técnica en condiciones subterráneas de alta complejidad fue fundamental para el éxito del proyecto.", s: 5 },
            { n: "Arq. Leandro", r: "Constructora SG+A", t: "El mantenimiento preventivo que realiza Plomería Campos en nuestros edificios ha reducido las emergencias en un 80%. Son socios estratégicos indispensables para nuestra gestión inmobiliaria.", s: 5 },
            { n: "Ing. Cimar Humerez", r: "Estación Central del Tren Metropolitano", t: "La instalación y el mantenimiento de las redes de agua y desagüe de la estación central del tren metropolitano fueron realizados con total profesionalismo y eficiencia por Plomería Campos.", s: 5 },
            { n: "Ing. Luis A. Siles", r: "Constructora Compacto S.R.L.", t: "La ejecución de las obras de plomería industrial e ingeniería hidrosanitaria en la Planta de Urea y Amoniaco en Cochabamba fue impecable, demostrando rigurosidad técnica y total apego a las normas de seguridad industrial.", s: 5 }
        ];

        const CARD_WIDTH = 420;
        const GAP = 24;
        const STEP = CARD_WIDTH + GAP;
        const AUTO_INTERVAL = 6000;
        const TRANSITION_MS = 600;
        const COUNT = testimonials.length;

        let currentIndex = 0; // logical index in original array
        let isAnimating = false;
        let autoTimer = null;

        const track = document.getElementById('testimonial-track');
        const dotsContainer = document.getElementById('testimonial-dots');

        function starsSVG(count) {
            return Array.from({ length: count }, () =>
                `<svg class="size-4 text-secondary fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`
            ).join('');
        }

        function cardHTML(t, idx) {
            const initial = t.n.charAt(0).toUpperCase();
            return `
                <div class="testimonial-card flex-shrink-0 relative bg-white dark:bg-[#0d1a2e]/90 rounded-[2rem] border border-neutral-200 dark:border-secondary/20 shadow-sm overflow-hidden transition-all duration-500 select-none cursor-grab active:cursor-grabbing"
                     style="width:${CARD_WIDTH}px; padding: 2.5rem;"
                     data-idx="${idx}">
                    <!-- Glow accent -->
                    <div class="absolute inset-0 bg-gradient-to-br from-secondary/0 to-secondary/0 card-glow transition-all duration-500 rounded-[2rem] pointer-events-none z-0"></div>
                    <!-- Quote icon -->
                    <div class="absolute top-6 right-8 text-neutral-100 dark:text-white/5 card-quote transition-colors duration-500 z-10">
                        <svg class="w-10 h-10 fill-current" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.883z"/></svg>
                    </div>
                    <!-- Stars -->
                    <div class="relative z-10 flex gap-x-1 mb-5">${starsSVG(t.s)}</div>
                    <!-- Text -->
                    <p class="text-neutral-600 dark:text-neutral-300 italic mb-7 relative z-10 leading-relaxed text-sm">&ldquo;${t.t}&rdquo;</p>
                    <!-- Author -->
                    <div class="relative z-10 flex items-center gap-x-4 border-t border-neutral-100 dark:border-secondary/10 pt-5">
                        <div class="size-11 rounded-full bg-primary/10 dark:bg-secondary/10 flex items-center justify-center text-primary dark:text-secondary font-black text-sm uppercase flex-shrink-0">${initial}</div>
                        <div>
                            <h4 class="font-bold text-primary dark:text-white leading-none mb-1 text-sm">${t.n}</h4>
                            <p class="text-xs text-neutral-500 dark:text-neutral-400 uppercase tracking-widest">${t.r}</p>
                        </div>
                    </div>
                </div>`;
        }

        function buildTrack() {
            // Triple the testimonials for seamless infinite loop: [clone_before | originals | clone_after]
            const all = [...testimonials, ...testimonials, ...testimonials];
            track.innerHTML = all.map((t, i) => cardHTML(t, i % COUNT)).join('');
        }

        function buildDots() {
            dotsContainer.innerHTML = testimonials.map((_, i) =>
                `<button class="testimonial-dot w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-secondary w-6' : 'bg-neutral-300 dark:bg-neutral-600'}" data-dot="${i}" aria-label="Ir al testimonio ${i + 1}"></button>`
            ).join('');
            dotsContainer.querySelectorAll('.testimonial-dot').forEach(btn => {
                btn.addEventListener('click', () => goTo(parseInt(btn.dataset.dot), true));
            });
        }

        function updateDots() {
            dotsContainer.querySelectorAll('.testimonial-dot').forEach((btn, i) => {
                const active = i === currentIndex;
                btn.className = `testimonial-dot rounded-full transition-all duration-300 ${active ? 'bg-secondary w-6 h-2' : 'bg-neutral-300 dark:bg-neutral-600 w-2 h-2'}`;
            });
        }

        function getViewportCenter() {
            return document.getElementById('testimonial-viewport').offsetWidth / 2;
        }

        // The "real" cards start at index COUNT in the track (middle set of the triple)
        function trackXForIndex(logicalIdx) {
            const trackStart = COUNT; // offset into middle set
            const cardIdx = trackStart + logicalIdx;
            const center = getViewportCenter();
            return -(cardIdx * STEP - center + CARD_WIDTH / 2);
        }

        function applyCardStyles(animate) {
            const cards = track.querySelectorAll('.testimonial-card');
            const center = getViewportCenter();
            const trackRect = track.getBoundingClientRect();
            const viewportRect = document.getElementById('testimonial-viewport').getBoundingClientRect();

            cards.forEach(card => {
                const cardRect = card.getBoundingClientRect();
                const cardCenter = cardRect.left + cardRect.width / 2 - viewportRect.left;
                const dist = Math.abs(cardCenter - center);
                const maxDist = STEP * 1.5;
                const ratio = Math.min(dist / maxDist, 1);

                const opacity = 1 - ratio * 0.65;
                const scale = 1 - ratio * 0.08;
                const blur = ratio * 1.5;

                card.style.opacity = opacity;
                card.style.transform = `scale(${scale})`;
                card.style.filter = `blur(${blur}px)`;

                const isCenter = dist < STEP * 0.5;
                const glowEl = card.querySelector('.card-glow');
                const quoteEl = card.querySelector('.card-quote');

                if (isCenter) {
                    card.style.boxShadow = 'var(--shadow-active, 0 20px 60px rgba(0,0,0,0.15))';
                    card.style.borderColor = 'rgba(128,204,226,0.4)';
                    if (glowEl) glowEl.style.background = 'linear-gradient(135deg, rgba(128,204,226,0.07), rgba(10,43,100,0.05))';
                    if (quoteEl) quoteEl.style.color = 'rgba(128,204,226,0.22)';
                } else {
                    card.style.boxShadow = '';
                    card.style.borderColor = '';
                    if (glowEl) glowEl.style.background = '';
                    if (quoteEl) quoteEl.style.color = '';
                }
            });
        }

        function setTrackX(x, withTransition) {
            track.style.transition = withTransition ? `transform ${TRANSITION_MS}ms cubic-bezier(0.25, 0.46, 0.45, 0.94)` : 'none';
            track.style.transform = `translateX(${x}px)`;
        }

        function goTo(logicalIdx, userAction = false) {
            if (isAnimating) return;
            isAnimating = true;
            currentIndex = ((logicalIdx % COUNT) + COUNT) % COUNT;
            updateDots();

            const x = trackXForIndex(currentIndex);
            setTrackX(x, true);

            // After transition ends, check if we need to silently jump (infinite loop)
            setTimeout(() => {
                // We always show the "middle" set, so no jump needed with triple clone strategy
                applyCardStyles(false);
                isAnimating = false;
            }, TRANSITION_MS + 50);

            if (userAction) resetAutoplay();
        }

        function advance() {
            if (isAnimating) return;
            isAnimating = true;

            const nextLogical = currentIndex + 1;
            const isWrapping = currentIndex === COUNT - 1;

            currentIndex = (nextLogical) % COUNT;
            updateDots();

            if (isWrapping) {
                // Animate to COUNT+COUNT (the start of the third set = same as start of second set visually)
                const toIdx = COUNT + COUNT; // wraps to beginning of third set
                const x = -(toIdx * STEP - getViewportCenter() + CARD_WIDTH / 2);
                setTrackX(x, true);

                setTimeout(() => {
                    // Silently jump back to second set position 0
                    setTrackX(trackXForIndex(0), false);
                    applyCardStyles(false);
                    isAnimating = false;
                }, TRANSITION_MS + 50);
            } else {
                setTrackX(trackXForIndex(currentIndex), true);
                setTimeout(() => {
                    applyCardStyles(false);
                    isAnimating = false;
                }, TRANSITION_MS + 50);
            }
        }

        function startAutoplay() {
            autoTimer = setInterval(advance, AUTO_INTERVAL);
        }

        function resetAutoplay() {
            clearInterval(autoTimer);
            startAutoplay();
        }

        // Drag/swipe support
        let dragStartX = null;
        let dragCurrentX = null;
        let isDragging = false;
        let trackStartX = 0;

        function getClientX(e) {
            return e.touches ? e.touches[0].clientX : e.clientX;
        }

        track.addEventListener('mousedown', e => {
            if (e.button !== 0) return;
            isDragging = true;
            dragStartX = getClientX(e);
            const mat = new DOMMatrix(getComputedStyle(track).transform);
            trackStartX = mat.m41;
            track.style.transition = 'none';
            track.style.cursor = 'grabbing';
            e.preventDefault();
        });

        track.addEventListener('touchstart', e => {
            dragStartX = getClientX(e);
            const mat = new DOMMatrix(getComputedStyle(track).transform);
            trackStartX = mat.m41;
            track.style.transition = 'none';
        }, { passive: true });

        window.addEventListener('mousemove', e => {
            if (!isDragging) return;
            dragCurrentX = getClientX(e);
            const dx = dragCurrentX - dragStartX;
            track.style.transform = `translateX(${trackStartX + dx}px)`;
            applyCardStyles(false);
        });

        track.addEventListener('touchmove', e => {
            if (dragStartX === null) return;
            dragCurrentX = getClientX(e);
            const dx = dragCurrentX - dragStartX;
            track.style.transform = `translateX(${trackStartX + dx}px)`;
            applyCardStyles(false);
        }, { passive: true });

        function endDrag() {
            if (!isDragging && dragStartX === null) return;
            isDragging = false;
            track.style.cursor = '';
            if (dragCurrentX !== null) {
                const dx = dragCurrentX - dragStartX;
                if (Math.abs(dx) > 60) {
                    goTo(dx < 0 ? currentIndex + 1 : currentIndex - 1, true);
                } else {
                    goTo(currentIndex, true);
                }
            }
            dragStartX = null;
            dragCurrentX = null;
        }

        window.addEventListener('mouseup', endDrag);
        track.addEventListener('touchend', endDrag);

        // Click on side cards to navigate
        track.addEventListener('click', e => {
            if (Math.abs((dragCurrentX || 0) - (dragStartX || 0)) > 10) return;
            const card = e.target.closest('.testimonial-card');
            if (!card) return;
            const idx = parseInt(card.dataset.idx);
            if (idx !== currentIndex) {
                goTo(idx, true);
            }
        });

        // Init
        buildTrack();
        buildDots();

        // Set initial position without animation
        requestAnimationFrame(() => {
            setTrackX(trackXForIndex(currentIndex), false);
            requestAnimationFrame(() => {
                applyCardStyles(false);
                startAutoplay();
            });
        });

        // Re-apply on resize
        window.addEventListener('resize', () => {
            setTrackX(trackXForIndex(currentIndex), false);
            applyCardStyles(false);
        });

        // Pause on hover
        const wrapper = document.getElementById('testimonial-carousel-wrapper');
        wrapper.addEventListener('mouseenter', () => clearInterval(autoTimer));
        wrapper.addEventListener('mouseleave', () => { clearInterval(autoTimer); startAutoplay(); });
    })();
